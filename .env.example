# ─────────────────────────────────────────────────────────────
# PescaPlus — TODAS las variables de entorno
# Copia este archivo a .env (local) y replica en Vercel (producción).
# La app arranca sin ninguna (catálogo local + memoria), pero para
# persistir datos y usar todas las funciones necesitas al menos DATABASE_URL.
# ─────────────────────────────────────────────────────────────

# ── OBLIGATORIAS EN PRODUCCIÓN ───────────────────────────────

# URL pública del sitio (metadatos SEO, sitemap, enlaces absolutos, emails).
# En Vercel: pon el dominio final de la NUEVA cuenta.
NEXT_PUBLIC_APP_URL="https://tu-dominio.com"

# Base de datos PostgreSQL (Aiven). Cópiala de Aiven → Service → Connection
# information → "Service URI". Debe llevar ?sslmode=require al final.
DATABASE_URL="postgres://avnadmin:PASSWORD@HOST-xxx.aivencloud.com:PORT/defaultdb?sslmode=require"

# (Opcional pero recomendado) Certificado CA de Aiven en formato PEM, para
# verificar el certificado del servidor. Descárgalo de Aiven → "CA Certificate".
# Si NO la pones, la conexión sigue siendo cifrada (TLS) pero sin verificar.
#
# Aquí, en un .env, va en UNA línea con \n como separadores:
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----\n"
#
# PERO en un panel de despliegue (Coolify, Dokploy, Portainer…) usa base64:
#
#     base64 -w0 ca.pem
#
# Motivo: esas plataformas inyectan las variables de construcción REESCRIBIENDO
# el Dockerfile, y el parser de Dockerfile se come las barras invertidas — cada
# \n se convierte en una "n" pegada al base64 y el certificado deja de valer.
# El base64 no lleva barras, así que ningún parser puede estropearlo. La app
# entiende las dos formas (lib/db-ca.ts).

# ── ADMINISTRACIÓN Y CRONS ───────────────────────────────────

# Panel /admin. Sin ella se usa "pescaplus-admin" (solo dev). DEFÍNELA en prod.
ADMIN_PASSWORD="cambia-esta-contrasena"

# Firma de sesión del admin. Genera una larga y aleatoria (ver README abajo).
ADMIN_SESSION_SECRET="un-secreto-largo-aleatorio"

# Secreto para los crons (/api/cron/*). Vercel lo envía como Bearer.
CRON_SECRET="un-secreto-largo-aleatorio"

# ── APIS DE DATOS (previsión / mareas / IA) ──────────────────

# AEMET OpenData (parte marítimo oficial y observaciones de estaciones).
# Es un JWT largo (empieza por "eyJ...").
AEMET_API_KEY="tu_jwt_de_aemet"

# WorldTides (mareas reales).
WORLDTIDES_API_KEY="tu_worldtides_key"

# IA (asistente y generación de textos): Groq primero (mucho más rápido y con
# muchísima más cuota gratis por día), OpenRouter como red de seguridad detrás.
# Basta con configurar uno de los dos; con los dos, más resistente a fallos.

# Groq. La clave empieza por "gsk_". Gratis: 30 peticiones/min POR MODELO,
# 14.400/día en llama-3.1-8b-instant y 1.000/día en llama-3.3-70b-versatile
# (documentación oficial de Groq, comprobado 2026-07-28).
GROQ_API_KEY="tu_clave_de_groq"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# NVIDIA (solo lo usa el PULIDO SEO). La clave empieza por "nvapi-".
# Está aquí porque su cupo diario es independiente del de Groq y OpenRouter:
# pulir un catálogo grande agota cualquier cupo individual, así que tener un
# tercer presupuesto separado es lo que permite terminar sin pagar.
NVIDIA_API_KEY="tu_clave_de_nvidia"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# OpenRouter. La clave empieza por "sk-or-".
OPENROUTER_API_KEY="tu_clave_de_openrouter"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Cadena de modelos con fallback (opcional, coma-separada); sin definir usa la de código
# (por defecto solo modelos gratuitos ":free" — ver el comentario en lib/openrouter-ai.ts
# para saber cuáles se probaron y funcionan). Aviso: OpenRouter limita los modelos ":free"
# a 20 peticiones/min y 50/día TOTAL, compartidas entre todos los modelos, por cuenta sin
# créditos comprados (sube a 1000/día si se compran alguna vez 10$, aunque se sigan usando
# modelos a coste 0).
# OPENROUTER_MODELS="google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-12b-v2-vl:free"

# ── IMPORTADOR DE PRODUCTOS (AliExpress) ─────────────────────

ALIEXPRESS_APP_KEY="tu_app_key"
ALIEXPRESS_APP_SECRET="tu_app_secret"
ALIEXPRESS_APP_TOKEN="tu_app_token"
ALIEXPRESS_TRACKING_ID="pescaplus"

# ── FOTOS DE LOS BARCOS ──────────────────────────────────────

# Carpeta donde se guardan las fotos que suben los patrones. Antes esto era
# Vercel Blob; desde la migración es disco del propio servidor.
#
# En el contenedor la fija el Dockerfile a /app/datos/fotos, y esa ruta TIENE
# que estar montada como volumen: si no, las fotos se escriben dentro del
# contenedor y el siguiente despliegue se las lleva SIN dar ningún error.
# /api/salud lo publica como "fotos":"efimero" para que se vea a tiempo.
#
# En desarrollo, si no se define, usa .datos/fotos dentro del proyecto.
# PHOTOS_DIR="/app/datos/fotos"

# ── EMAIL DE ALERTAS (opcional) ──────────────────────────────
# Sin estas, las alertas por email quedan en modo simulación (dry-run).
# RESEND_API_KEY="re_..."
# RESEND_FROM="PescaPlus <alertas@tu-dominio.com>"
