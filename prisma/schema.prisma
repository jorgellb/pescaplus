generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  sku          String  @unique @map("aliexpressId")
  title       String
  description String
  imageUrl    String
  images      String[] @default([])
  imageAlts   String[] @default([])
  videoUrl    String   @default("")
  price       Float
  currency    String   @default("EUR")
  affiliateUrl String
  category    String
  typeFishing String   // primary category (spinning, flyfishing, carp, etc.)
  categories  String[] @default([]) // all main categories (includes typeFishing)
  subcategory String   @default("") // primary subcategory (= subcategories[0])
  subcategories String[] @default([]) // all subcategory placements
  rating      Float    @default(0)
  reviews     Int      @default(0)
  inStock     Boolean  @default(true)
  seoTitle    String   @default("")
  seoDescription String @default("")
  aiOptimized Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([typeFishing])
  @@index([category])
}

model FishingAdvice {
  id          String   @id @default(cuid())
  typeFishing String
  title       String
  content     String
  tags        String[]
  relatedProducts String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([typeFishing])
}

model Guide {
  id             String   @id
  title          String
  excerpt        String   @default("")
  content        String
  coverImage     String   @default("")
  coverImageAlt  String   @default("")
  typeFishing    String   @default("")
  seoTitle       String   @default("")
  seoDescription String   @default("")
  aiOptimized    Boolean  @default(false)
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published])
}

model Setting {
  key       String   @id
  value     String   // JSON blob (e.g. taxonomy overrides)
  updatedAt DateTime @updatedAt
}
model ProductClick {
  id           String   @id @default(cuid())
  productId    String
  productTitle String   @default("")
  typeFishing  String   @default("")
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String   @default("")
  email     String   @default("")
  subject   String   @default("")
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AlertSubscription {
  id        String   @id @default(cuid())
  email     String
  spotSlug  String
  especie   String   @default("")
  threshold Int      @default(75)
  createdAt DateTime @default(now())

  @@unique([email, spotSlug])
  @@index([spotSlug])
}

model ForecastCheck {
  id          String    @id @default(cuid())
  spotSlug    String
  dateISO     String
  targetUtc   String
  idema       String
  predWindKmh Float
  obsWindKmh  Float?
  errorKmh    Float?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@unique([spotSlug, dateISO])
  @@index([spotSlug, resolvedAt])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String   @default("")
  phone         String   @default("")
  phoneVerified Boolean  @default(false)
  bio           String   @default("")
  avatar        String   @default("") // emoji elegido por el usuario
  emailVerified Boolean  @default(false)
  // Reputación como pescador (denormalizada desde Review 'toAngler').
  avgRating     Float    @default(0)
  reviewCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  bookings CharterBooking[]
  rsvps    Rsvp[]
  operator Operator?
  reviews  Review[]         @relation("ReviewAuthor")

  @@index([email])
}

// Sesión de acceso (cookie httpOnly guarda el id). En BD para poder revocar.
model Session {
  id        String   @id
  userId    String
  userAgent String   @default("")
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Token de un solo uso del enlace mágico de acceso.
model LoginToken {
  id        String    @id
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// Reseña tras una salida, en ambos sentidos (confianza tipo marketplace):
// el pescador valora al patrón y el patrón valora a cada pescador que embarcó.
model Review {
  id           String   @id @default(cuid())
  operatorId   String
  charterId    String   @default("")
  authorUserId String
  // 'toOperator' = pescador→patrón · 'toAngler' = patrón→pescador
  direction    String   @default("toOperator")
  // Pescador valorado (solo en 'toAngler'); "" cuando se valora al patrón.
  subjectUserId String  @default("")
  rating       Int // 1..5
  text         String   @default("")
  // Doble ciego: null mientras está oculta; se publica cuando la otra parte
  // también valora, o al vencer el plazo (ver REVIEW_BLIND_DAYS).
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  author       User     @relation("ReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  // Un autor deja una reseña por sujeto y salida (el patrón valora a varios).
  @@unique([charterId, authorUserId, subjectUserId])
  @@index([operatorId])
  @@index([subjectUserId])
  @@index([publishedAt])
}

// Conversación in-app entre un pescador y un patrón sobre un chárter concreto.
model Thread {
  id             String    @id @default(cuid())
  charterId      String
  operatorId     String
  userId         String // el pescador
  lastMessageAt  DateTime  @default(now())
  unreadUser     Int       @default(0) // mensajes sin leer por el pescador
  unreadOperator Int       @default(0) // mensajes sin leer por el patrón
  createdAt      DateTime  @default(now())
  messages       Message[]

  @@unique([charterId, userId])
  @@index([userId])
  @@index([operatorId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  sender    String // 'user' | 'operator'
  body      String
  createdAt DateTime @default(now())
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model Meetup {
  id           String   @id @default(cuid())
  // Secret token: whoever holds it can edit/cancel the meetup (no accounts).
  manageToken  String   @unique
  hostName     String
  // Contact channel (WhatsApp/phone/email) shown to attendees once they join.
  hostContact  String
  spotSlug     String
  meetingPoint String   @default("")
  dateISO      String // YYYY-MM-DD (local)
  timeStart    String // "07:00" (quedada) o franja ("Mañana") en una llamada
  kind         String   @default("quedada") // quedada | llamada (¿quién se apunta?)
  durationH    Float?
  modality     String // tierra | kayak | barco
  targetSpecies String  @default("")
  level        String   @default("cualquiera") // principiante | medio | experto | cualquiera
  maxPlaces    Int      @default(4)
  minToConfirm Int      @default(1)
  // Ficha detallada (ids del catálogo compartido en lib/charter-options).
  techniques   String[] @default([])
  species      String[] @default([]) // especies objetivo (multi)
  bring        String[] @default([]) // qué tiene que llevar cada uno
  costMode     String   @default("gratis") // gratis | fijo | reparto
  costShare    Float? // per-person fixed cost (costMode 'fijo')
  totalCost    Float? // total to split among all aboard (costMode 'reparto')
  notes        String   @default("")
  status       String   @default("open") // open | confirmed | cancelled
  createdAt    DateTime @default(now())
  rsvps        Rsvp[]

  @@index([spotSlug, dateISO])
  @@index([dateISO])
}

model Rsvp {
  id        String   @id @default(cuid())
  meetupId  String
  userId    String? // vinculado a la cuenta si el pescador estaba logueado
  name      String
  contact   String   @default("")
  places    Int      @default(1)
  status    String   @default("in") // in | out
  createdAt DateTime @default(now())
  meetup    Meetup   @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([meetupId])
  @@index([userId])
}

model ZoneMeetupAlert {
  id        String   @id @default(cuid())
  email     String
  spotSlug  String
  createdAt DateTime @default(now())

  @@unique([email, spotSlug])
  @@index([spotSlug])
}

model Operator {
  id           String    @id @default(cuid())
  // Secret token so the operator manages their charters without an account.
  manageToken  String    @unique
  name         String
  businessName String    @default("")
  email        String
  phone        String    @default("")
  spotSlug     String // home port / base zone
  boatName     String    @default("")
  boatType     String    @default("")
  capacity     Int       @default(6)
  // — Características del barco (se muestran en cada ficha de chárter) —
  marina         String  @default("") // amarre base: "Marina Deportiva del Puerto de Alicante"
  boatLength     Float? // eslora en metros
  boatBeam       Float? // manga en metros
  boatEngineHp   Int? // potencia total en CV
  boatMaxSpeedKn Int? // velocidad máxima en nudos
  boatYear       Int?
  crewSize       Int     @default(1)
  photos         String[] @default([]) // fotos del barco / de salidas
  navigation     String[] @default([]) // electrónica
  safety         String[] @default([])
  amenities      String[] @default([])
  gear           String[] @default([])
  licenseRef   String    @default("") // titulación / licencia (a verificar)
  insuranceRef String    @default("") // seguro de ocupantes / RC
  bio          String    @default("")
  // Only verified operators (license + insurance checked) go public and can charge.
  verified     Boolean   @default(false)
  verifiedAt   DateTime?
  // Stripe Connect (Express) — set when the operator connects payouts.
  stripeAccountId String @default("")
  stripeReady     Boolean @default(false)
  // Reputación (denormalizada desde Review para listados rápidos).
  avgRating    Float     @default(0)
  reviewCount  Int       @default(0)
  // Cuenta de usuario dueña de este perfil de patrón (si se registró logueado).
  userId       String?   @unique
  createdAt    DateTime  @default(now())
  charters     Charter[]
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([spotSlug])
  @@index([verified])
}

model Charter {
  id             String           @id @default(cuid())
  operatorId     String
  spotSlug       String
  dateISO        String
  timeStart      String
  durationH      Float?
  modality       String           @default("barco")
  targetSpecies  String           @default("")
  level          String           @default("cualquiera")
  pricePerPerson Float
  maxPlaces      Int              @default(6)
  minToConfirm   Int              @default(1)
  includes       String           @default("") // equipo, cebo, licencia incluidos
  notes          String           @default("")
  status         String           @default("open") // open | confirmed | cancelled
  // — Ficha detallada de la salida (ids del catálogo en lib/charter-options) —
  /** Salidas creadas de una vez comparten seriesId (repetición semanal). */
  seriesId       String           @default("")
  tripType       String           @default("compartida") // privada | compartida
  meetingPoint   String           @default("") // amarre / punto de encuentro exacto
  highlights     String           @default("") // lo más destacado, una línea
  languages      String[]         @default([])
  techniques     String[]         @default([])
  species        String[]         @default([]) // especies objetivo (multi)
  areas          String[]         @default([])
  included       String[]         @default([])
  excluded       String[]         @default([])
  policies       String[]         @default([])
  seasons        String[]         @default([])
  /** Precio de la salida completa cuando es privada (en vez de por persona). */
  privatePrice   Float?
  createdAt      DateTime         @default(now())
  operator       Operator         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  bookings       CharterBooking[]

  @@index([spotSlug, dateISO])
  @@index([operatorId])
  @@index([seriesId])
}

model CharterBooking {
  id        String   @id @default(cuid())
  charterId String
  userId    String? // vinculado a la cuenta si el pescador estaba logueado
  /** payment_intent de Stripe: idempotencia del webhook y base del reembolso. */
  paymentRef String  @default("")
  name      String
  contact   String
  people    Int      @default(1)
  message   String   @default("")
  // requested → accepted/declined by operator → paid (when Stripe is wired) → cancelled
  status    String   @default("requested")
  createdAt DateTime @default(now())
  charter   Charter  @relation(fields: [charterId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([charterId])
  @@index([userId])
  @@index([paymentRef])
}
